# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL 14+ instance. `docker compose up -d db` gives you this exact URL.
DATABASE_URL="postgresql://lexicon:lexicon@localhost:5432/lexicon?schema=public"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Signs access + refresh tokens. MUST be >= 32 chars and unique per environment.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# Minutes an access token stays valid. Refresh tokens live for REFRESH_TTL_DAYS.
ACCESS_TTL_MINUTES="30"
REFRESH_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# AI (optional — the app runs fully without it)
# ---------------------------------------------------------------------------
# When unset, every AI surface (tutor, debate, writing coach, grammar feedback)
# falls back to the deterministic rules engine in src/lib/ai/heuristics.ts.
# The UI labels this clearly; no feature disappears.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_BASE_URL=""

# ---------------------------------------------------------------------------
# GPT as a Claude Code tool (optional, development only)
# ---------------------------------------------------------------------------
# The MCP server in tools/mcp/openai/ lets Claude Code consult a GPT model during
# a session. It reuses OPENAI_API_KEY above and never runs in production.
# These override the app's settings for that path only; see docs/MCP-OPENAI.md.
OPENAI_MCP_MODEL=""
OPENAI_MCP_TIMEOUT_MS="90000"
OPENAI_MCP_MAX_TOKENS="4000"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Lexicon"
# The public origin, without a trailing slash. In production this MUST be the
# real https:// address: it becomes the canonical URL on every page, the
# sitemap, the Open Graph URLs and the JSON-LD that search engines and AI
# assistants read. With localhost here, they are told the site lives on your
# laptop.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public identity (optional) — who is behind the site
# ---------------------------------------------------------------------------
# Shown on /about and in the footer, and published in the structured data
# (JSON-LD Person / Organization), llms.txt and the <meta name="author"> tag so
# that search engines and AI assistants can attribute the site to you. Leave
# any of these blank to omit it; nothing here is ever required.
NEXT_PUBLIC_AUTHOR_NAME=""
NEXT_PUBLIC_AUTHOR_URL=""
NEXT_PUBLIC_CONTACT_EMAIL=""
# Comma-separated profile URLs (GitHub, LinkedIn, X, YouTube, …). Feeds the
# JSON-LD `sameAs` property, which is how AI search links the site to profiles
# it already knows about.
NEXT_PUBLIC_SOCIAL_LINKS=""
# Public repository, if the code is open. Linked from /about and llms.txt.
NEXT_PUBLIC_SOURCE_URL=""

# Per-IP request ceilings (sliding window). Tune for your traffic.
RATE_LIMIT_AUTH_PER_MIN="10"
RATE_LIMIT_AI_PER_MIN="20"
