# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL 14+ instance. `docker compose up -d db` gives you this exact URL.
DATABASE_URL="postgresql://lexicon:lexicon@localhost:5432/lexicon?schema=public"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Signs access + refresh tokens. MUST be >= 32 chars and unique per environment.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# Minutes an access token stays valid. Refresh tokens live for REFRESH_TTL_DAYS.
ACCESS_TTL_MINUTES="30"
REFRESH_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# AI (optional — the app runs fully without it)
# ---------------------------------------------------------------------------
# When unset, every AI surface (tutor, debate, writing coach, grammar feedback)
# falls back to the deterministic rules engine in src/lib/ai/heuristics.ts.
# The UI labels this clearly; no feature disappears.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_BASE_URL=""

# ---------------------------------------------------------------------------
# GPT as a Claude Code tool (optional, development only)
# ---------------------------------------------------------------------------
# The MCP server in tools/mcp/openai/ lets Claude Code consult a GPT model during
# a session. It reuses OPENAI_API_KEY above and never runs in production.
# These override the app's settings for that path only; see docs/MCP-OPENAI.md.
OPENAI_MCP_MODEL=""
OPENAI_MCP_TIMEOUT_MS="90000"
OPENAI_MCP_MAX_TOKENS="4000"

# ---------------------------------------------------------------------------
# Live interpreter (optional)
# ---------------------------------------------------------------------------
# Real-time voice translation over WebRTC; see docs/REALTIME-TRANSLATION.md and
# agents/interpreter/README.md. Leave LIVEKIT_* empty to disable it (the page
# says so and the session endpoint returns 503).
# LIVEKIT_URL is the PUBLIC ws(s):// address browsers connect to. For local
# development with `docker compose --profile interpreter up -d`, use:
#   LIVEKIT_URL="ws://localhost:7880"  LIVEKIT_API_KEY="devkey"  LIVEKIT_API_SECRET="secret"
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Must match the agent's INTERPRETER_AGENT_NAME (default "interpreter").
INTERPRETER_AGENT_NAME="interpreter"
# Interpreter minutes per learner per UTC day, and the longest single session.
INTERPRETER_DAILY_MINUTES="30"
INTERPRETER_MAX_SESSION_MINUTES="15"
# Vendor rates for the cost estimate on /interpreter/stats (admins). Leave 0
# to see raw usage instead. Check each vendor's current price list.
INTERPRETER_COST_ASR_PER_MIN="0"
INTERPRETER_COST_MT_INPUT_PER_MTOK="0"
INTERPRETER_COST_MT_OUTPUT_PER_MTOK="0"
INTERPRETER_COST_MT_CACHE_READ_PER_MTOK="0"
INTERPRETER_COST_MT_CACHE_WRITE_PER_MTOK="0"
INTERPRETER_COST_TTS_PER_1K_CHARS="0"
# Read by the agent, not the app (docker compose passes them through):
# Deepgram streaming ASR for live captions, and Anthropic for the live
# translation. Without a key, that feature shows as unavailable.
DEEPGRAM_API_KEY=""
ANTHROPIC_API_KEY=""
# Translation model; a small, fast model keeps the lag down. The fallback is
# used while the main model is overloaded or failing (optional).
INTERPRETER_MT_MODEL="claude-haiku-5-5"
INTERPRETER_MT_FALLBACK_MODEL=""
# Spoken translation (Cartesia streaming TTS). Voice ids come from your
# Cartesia account or its voice library; the voice should speak the target
# languages you offer.
CARTESIA_API_KEY=""
CARTESIA_VOICE_ID=""
# Where the agent sends each session's usage and latency report: this app's
# POST /api/interpreter/report (signed with LIVEKIT_API_SECRET). Unset, the
# report is only logged, and quotas count sessions at their full limit.
INTERPRETER_REPORT_URL=""
# OpenTelemetry (optional): set to export the agent's traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Lexicon"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Per-IP request ceilings (sliding window). Tune for your traffic.
RATE_LIMIT_AUTH_PER_MIN="10"
RATE_LIMIT_AI_PER_MIN="20"
